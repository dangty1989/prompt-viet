# ---------------------------------------------------------------------------
# Thông tin ủng hộ dự án (Prompt Việt)
#
# Copy file này thành `.env.local` và điền thông tin thật.
# Mọi biến để trống => component TỰ ẨN phần đó, KHÔNG hiển thị dữ liệu mẫu.
# Các biến đều là NEXT_PUBLIC_* nên sẽ được nhúng vào bản static export lúc build.
# ---------------------------------------------------------------------------

# --- Chuyển khoản ngân hàng ---
# Mã BIN ngân hàng theo danh mục NAPAS (vd: Vietcombank = 970436, MB = 970422, Techcombank = 970407)
NEXT_PUBLIC_DONATE_BANK_ID=
# Tên ngân hàng hiển thị (vd: Vietcombank)
NEXT_PUBLIC_DONATE_BANK_NAME=
# Tên chủ tài khoản (vd: NGUYEN VAN A)
NEXT_PUBLIC_DONATE_ACCOUNT_NAME=
# Số tài khoản (vd: 1234567890)
NEXT_PUBLIC_DONATE_ACCOUNT_NUMBER=
# Nội dung chuyển khoản gợi ý
NEXT_PUBLIC_DONATE_TRANSFER_NOTE=UNG HO PROMPT VIET
# Ảnh QR ngân hàng (đường dẫn trong public/, vd /images/qr-vietcombank.png).
# Nếu để trống và có BANK_ID + ACCOUNT_NUMBER thì site tự sinh ảnh QR qua VietQR.
NEXT_PUBLIC_DONATE_BANK_QR=

# --- Ví điện thoại (MoMo / ZaloPay) ---
# Chỉ cần MOMO_QR là khối ủng hộ ví đã hiển thị. Tên/SĐT là tuỳ chọn:
# để trống nếu chỉ muốn hiện mã QR, không công khai số điện thoại.
NEXT_PUBLIC_DONATE_MOMO_NAME=
NEXT_PUBLIC_DONATE_MOMO_PHONE=
NEXT_PUBLIC_DONATE_MOMO_QR=

# --- Link ủng hộ quốc tế ---
NEXT_PUBLIC_DONATE_BMAC_URL=
NEXT_PUBLIC_DONATE_KOFI_URL=
NEXT_PUBLIC_DONATE_GITHUB_SPONSORS_URL=

# --- Thông báo khi chưa có thông tin nhận ủng hộ ---
NEXT_PUBLIC_DONATE_NOTICE=

# --- Khảo sát chất lượng prompt (Google Form) ---
# Để trống => khối khảo sát tự ẩn. Phải là link forms.gle hoặc forms.google.com.
NEXT_PUBLIC_SURVEY_FORM_URL=

# ---------------------------------------------------------------------------
# Link site / social
# Để trống => nút/link tương ứng tự ẩn (không còn link github.com giả).
# ---------------------------------------------------------------------------
# Repo GitHub của dự án, vd https://github.com/tyauto/prompt-viet
NEXT_PUBLIC_GITHUB_REPO_URL=

# ---------------------------------------------------------------------------
# Domain / SEO
# ---------------------------------------------------------------------------
# URL gốc của site (canonical, sitemap, robots, OG url). Bỏ trống => dùng
# https://prompt-viet.vercel.app. Đổi sang Cloudflare Pages / domain riêng thì
# set ở đây rồi build lại (vd https://promptviet.pages.dev).
NEXT_PUBLIC_SITE_URL=
# Blog hiển thị ở navbar / footer / sidebar (link ngoài, mở tab mới).
# Bỏ trống => dùng https://tyauto.name.vn
NEXT_PUBLIC_BLOG_URL=
# Mã xác minh Google Search Console (chỉ phần content, vd "abc123..."). Trống => không render.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# ───── Ops secrets: GitHub + Cloudflare (copy sang .env, không commit) ─────
# GITHUB_TOKEN=
# GITHUB_OWNER=dangty1989
# GITHUB_REPO=
# GITHUB_BRANCH=main
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_PROJECT=
# SITE_DOMAIN=
